{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Win32 GUI Application",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/portfolio_gui.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Win32 GUI Application"
        },
        {
            "name": "Debug Portfolio CLI (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/portfolio.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Portfolio (Pure C++ CLI)"
        }
    ]
}
